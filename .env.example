# Copy to .env and fill in. .env is git-ignored - NEVER commit it.
# Generate a secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=expenses
# Used when running the app/alembic directly on your machine (not in docker):
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/expenses
REDIS_URL=redis://localhost:6379/0

# Local S3 emulator (moto) only - it accepts any values. On AWS leave these unset: the app uses its IAM role.
AWS_ACCESS_KEY_ID=local-dev-key
AWS_SECRET_ACCESS_KEY=local-dev-secret
S3_BUCKET=expense-receipts
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
