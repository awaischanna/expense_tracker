{
  "info": {
    "name": "Ahya Expense Tracker API",
    "description": "Run the requests top to bottom. Login/refresh store tokens in collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": "1"
    },
    {
      "key": "expenseId",
      "value": "1"
    },
    {
      "key": "etag",
      "value": "\"1\""
    },
    {
      "key": "jobId",
      "value": ""
    },
    {
      "key": "receiptKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"password123\",\n  \"base_currency\": \"PKR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', j.access_token);",
                  "  pm.collectionVariables.set('refreshToken', j.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', j.access_token);",
                  "  pm.collectionVariables.set('refreshToken', j.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Create category",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Food\",\n  \"monthly_budget\": \"50000.00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('categoryId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List categories (spend vs budget)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Expenses",
      "item": [
        {
          "name": "Create expense (idempotent)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/expenses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": \"{{categoryId}}\",\n  \"amount\": \"1250.50\",\n  \"currency\": \"PKR\",\n  \"description\": \"Lunch\",\n  \"spent_on\": \"2026-10-20\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('expenseId', pm.response.json().id);",
                  "  pm.collectionVariables.set('etag', pm.response.headers.get('ETag'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List expenses",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/expenses?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20",
                  "disabled": false
                },
                {
                  "key": "cursor",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "category_id",
                  "value": "{{categoryId}}",
                  "disabled": true
                },
                {
                  "key": "date_from",
                  "value": "2026-10-01",
                  "disabled": true
                },
                {
                  "key": "date_to",
                  "value": "2026-10-31",
                  "disabled": true
                },
                {
                  "key": "min_amount",
                  "value": "10",
                  "disabled": true
                },
                {
                  "key": "max_amount",
                  "value": "5000",
                  "disabled": true
                },
                {
                  "key": "currency",
                  "value": "PKR",
                  "disabled": true
                },
                {
                  "key": "q",
                  "value": "lunch",
                  "disabled": true
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Get expense (returns ETag)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/expenses/{{expenseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses",
                "{{expenseId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('etag', pm.response.headers.get('ETag'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update expense (If-Match)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "If-Match",
                "value": "{{etag}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/expenses/{{expenseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses",
                "{{expenseId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"1300.00\",\n  \"description\": \"Lunch with team\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set('etag', pm.response.headers.get('ETag'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete expense",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/expenses/{{expenseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses",
                "{{expenseId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Receipts",
      "item": [
        {
          "name": "Get upload URL",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/expenses/{{expenseId}}/receipt/upload-url",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses",
                "{{expenseId}}",
                "receipt",
                "upload-url"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content_type\": \"image/png\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set('receiptKey', pm.response.json().key);"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm upload",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/expenses/{{expenseId}}/receipt/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses",
                "{{expenseId}}",
                "receipt",
                "confirm"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"{{receiptKey}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Get download URL (15 min)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/expenses/{{expenseId}}/receipt",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses",
                "{{expenseId}}",
                "receipt"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "CSV import",
      "item": [
        {
          "name": "Upload CSV",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/expenses/import",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses",
                "import"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "postman/sample_import.csv"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 202) pm.collectionVariables.set('jobId', pm.response.json().job_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Import status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/imports/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "imports",
                "{{jobId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Reports & notifications",
      "item": [
        {
          "name": "Monthly report",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports/monthly?year=2026&month=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports",
                "monthly"
              ],
              "query": [
                {
                  "key": "year",
                  "value": "2026",
                  "disabled": false
                },
                {
                  "key": "month",
                  "value": "10",
                  "disabled": false
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Notifications",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notifications?limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50",
                  "disabled": false
                },
                {
                  "key": "before_id",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}